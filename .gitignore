# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
qa/

# Nunca publicables (ver CLAUDE.md, regla 1). Ignorados para que un
# "git add -A" no los pueda colar aunque estén en el disco.
public/portfolio/**/crm_renew.png
public/portfolio/ortodoncia/

# Originales sin procesar: las capturas buenas las genera prepara-capturas.py
public/portfolio/**/Captura de pantalla*
